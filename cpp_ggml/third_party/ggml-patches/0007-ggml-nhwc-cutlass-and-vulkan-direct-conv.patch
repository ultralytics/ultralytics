+static __global__ void fp32_to_fp16_kernel(const float * src, half * dst, int64_t count) {
+    const int64_t index = blockIdx.x * blockDim.x + threadIdx.x;
+    if (index < count) dst[index] = __float2half(src[index]);
+}
+
+template <typename T>
+static __global__ void transpose_batched_kernel(
+        const T * src, T * dst, int64_t rows, int64_t columns) {
+    __shared__ T tile[32][33];
+    const int64_t batch = blockIdx.z;
+    const int64_t src_x = blockIdx.x * 32 + threadIdx.x;
+    const int64_t src_y = blockIdx.y * 32 + threadIdx.y;
+    const T * src_batch = src + batch * rows * columns;
+    T * dst_batch = dst + batch * rows * columns;
+    for (int offset = 0; offset < 32; offset += 8) {
+        if (src_x < columns && src_y + offset < rows) {
+            tile[threadIdx.y + offset][threadIdx.x] = src_batch[(src_y + offset) * columns + src_x];
+        }
+    }
+    __syncthreads();
+    const int64_t dst_x = blockIdx.y * 32 + threadIdx.x;
+    const int64_t dst_y = blockIdx.x * 32 + threadIdx.y;
+    for (int offset = 0; offset < 32; offset += 8) {
+        if (dst_x < rows && dst_y + offset < columns) {
+            dst_batch[(dst_y + offset) * rows + dst_x] = tile[threadIdx.x][threadIdx.y + offset];
+        }
+    }
+}
+
+static void nchw_to_nhwc(const void * src, void * dst, cudnnDataType_t type,
+                         int64_t batches, int64_t channels, int64_t height, int64_t width, cudaStream_t stream) {
+    const int64_t total = batches * channels * height * width;
+    GGML_UNUSED(total);
+    const int64_t spatial = height * width;
+    const dim3 blocks((spatial + 31) / 32, (channels + 31) / 32, batches);
+    const dim3 threads(32, 8);
+    if (type == CUDNN_DATA_HALF) {
+        transpose_batched_kernel<<<blocks, threads, 0, stream>>>(
+            (const half *) src, (half *) dst, channels, spatial);
+    } else {
+        transpose_batched_kernel<<<blocks, threads, 0, stream>>>(
+            (const float *) src, (float *) dst, channels, spatial);
+    }
+}
+
+static void nhwc_to_nchw(const void * src, void * dst, cudnnDataType_t type,
+                         int64_t batches, int64_t channels, int64_t height, int64_t width, cudaStream_t stream) {
+    const int64_t spatial = height * width;
+    const dim3 blocks((channels + 31) / 32, (spatial + 31) / 32, batches);
+    const dim3 threads(32, 8);
+    if (type == CUDNN_DATA_HALF) {
+        transpose_batched_kernel<<<blocks, threads, 0, stream>>>(
+            (const half *) src, (half *) dst, spatial, channels);
+    } else {
+        transpose_batched_kernel<<<blocks, threads, 0, stream>>>(
+            (const float *) src, (float *) dst, spatial, channels);
+    }
+}
