From e623ecf4c0ae7bba499906abee999dcf5ef8b604 Mon Sep 17 00:00:00 2001
From: yolo-ggml <dev@local>
Date: Mon, 17 Aug 2026 15:55:50 +0800
Subject: [PATCH] ggml-cpu: parallelise im2col over output rows instead of
 channels

The im2col kernels sliced the thread work on the input-channel loop
(iic = ith; iic < IC; iic += nth). For vision graphs that choice
backfires twice: IC is frequently tiny (3 for RGB stems, 8-64 early
stage), leaving threads idle, and every thread writes the same
(oh,ow) slot of dst so the stores ping-pong between cores.

Slice on the flattened output-row space N*OH instead, which is at
least 80x480 for detection inputs, keeps every thread writing a
contiguous dst span, and leaves the micro kernel untouched.
---
 src/ggml-cpu/ops.cpp | 99 ++++++++++++++++++++++----------------------
 1 file changed, 49 insertions(+), 50 deletions(-)

diff --git a/src/ggml-cpu/ops.cpp b/src/ggml-cpu/ops.cpp
index 42ec809c..7545d272 100644
--- a/src/ggml-cpu/ops.cpp
+++ b/src/ggml-cpu/ops.cpp
@@ -6390,25 +6390,28 @@ static void ggml_compute_forward_im2col_f32(
     {
         float * const wdata = (float *) dst->data;
 
-        for (int64_t in = 0; in < N; in++) {
-            for (int64_t ioh = 0; ioh < OH; ioh++) { // 1
-                for (int64_t iow = 0; iow < OW; iow++) {
-                    for (int64_t iic = ith; iic < IC; iic += nth) {
-
-                        // micro kernel
-                        float * dst_data = wdata + (in*OH*OW + ioh*OW + iow)*(IC*KH*KW); // [IC, KH, KW]
-                        const float * const src_data = (float *)((char *) src1->data + in*ofs0 + iic*ofs1); // [IH, IW]
-
-                        for (int64_t ikh = 0; ikh < KH; ikh++) {  // 1
-                            for (int64_t ikw = 0; ikw < KW; ikw++) {
-                                const int64_t iiw = iow*s0 + ikw*d0 - p0;
-                                const int64_t iih = ioh*s1 + ikh*d1 - p1;
-
-                                if (iih < 0 || iih >= IH || iiw < 0 || iiw >= IW) {
-                                    dst_data[iic*(KH*KW) + ikh*KW + ikw] = 0;
-                                } else {
-                                    dst_data[iic*(KH*KW) + ikh*KW + ikw] = (src_data[iih*IW + iiw]);
-                                }
+        // Parallelise over output rows (N*OH): the spatial dimension is far
+        // larger than IC, and slicing on IC both starves threads (IC can be 3)
+        // and makes every thread write the same (oh,ow) slot of dst.
+        for (int64_t row = ith; row < N*OH; row += nth) {
+            const int64_t in  = row / OH;
+            const int64_t ioh = row % OH;
+            for (int64_t iow = 0; iow < OW; iow++) {
+                for (int64_t iic = 0; iic < IC; iic++) {
+
+                    // micro kernel
+                    float * dst_data = wdata + (in*OH*OW + ioh*OW + iow)*(IC*KH*KW); // [IC, KH, KW]
+                    const float * const src_data = (float *)((char *) src1->data + in*ofs0 + iic*ofs1); // [IH, IW]
+
+                    for (int64_t ikh = 0; ikh < KH; ikh++) {  // 1
+                        for (int64_t ikw = 0; ikw < KW; ikw++) {
+                            const int64_t iiw = iow*s0 + ikw*d0 - p0;
+                            const int64_t iih = ioh*s1 + ikh*d1 - p1;
+
+                            if (iih < 0 || iih >= IH || iiw < 0 || iiw >= IW) {
+                                dst_data[iic*(KH*KW) + ikh*KW + ikw] = 0;
+                            } else {
+                                dst_data[iic*(KH*KW) + ikh*KW + ikw] = (src_data[iih*IW + iiw]);
                             }
                         }
                     }
@@ -6418,11 +6421,6 @@ static void ggml_compute_forward_im2col_f32(
     }
 }
 
-
-// ggml_compute_forward_im2col_f16
-// src0: kernel [OC, IC, KH, KW]
-// src1: image [N, IC, IH, IW]
-// dst:  result [N, OH, OW, IC*KH*KW]
 static void ggml_compute_forward_im2col_f16(
         const ggml_compute_params * params,
               ggml_tensor * dst) {
@@ -6466,33 +6464,34 @@ static void ggml_compute_forward_im2col_f16(
     {
         ggml_fp16_t * const wdata = (ggml_fp16_t *) dst->data;
 
-        for (int64_t in = 0; in < N; in++) {
-            for (int64_t ioh = 0; ioh < OH; ioh++) { // 1
-                for (int64_t iow = 0; iow < OW; iow++) {
-                    for (int64_t iic = ith; iic < IC; iic += nth) {
-
-                        // micro kernel
-                        ggml_fp16_t * dst_data = wdata + (in*OH*OW + ioh*OW + iow)*(IC*KH*KW); // [IC, KH, KW]
-                        const float * const src_data_f32 = src1->type == GGML_TYPE_F32
-                            ? (const float *)((const char *) src1->data + in*ofs0 + iic*ofs1)
-                            : nullptr; // [IH, IW]
-                        const ggml_fp16_t * const src_data_f16 = src1->type == GGML_TYPE_F16
-                            ? (const ggml_fp16_t *)((const char *) src1->data + in*ofs0 + iic*ofs1)
-                            : nullptr; // [IH, IW]
-
-                        for (int64_t ikh = 0; ikh < KH; ikh++) {  // 1
-                            for (int64_t ikw = 0; ikw < KW; ikw++) {
-                                const int64_t iiw = iow*s0 + ikw*d0 - p0;
-                                const int64_t iih = ioh*s1 + ikh*d1 - p1;
-
-                                if (iih < 0 || iih >= IH || iiw < 0 || iiw >= IW) {
-                                    dst_data[iic*(KH*KW) + ikh*KW + ikw] = 0;
+        // Parallelise over output rows (N*OH): see im2col_f32 above.
+        for (int64_t row = ith; row < N*OH; row += nth) {
+            const int64_t in  = row / OH;
+            const int64_t ioh = row % OH;
+            for (int64_t iow = 0; iow < OW; iow++) {
+                for (int64_t iic = 0; iic < IC; iic++) {
+
+                    // micro kernel
+                    ggml_fp16_t * const dst_data = wdata + (in*OH*OW + ioh*OW + iow)*(IC*KH*KW); // [IC, KH, KW]
+                    const float * const src_data_f32 = src1->type == GGML_TYPE_F32
+                        ? (const float *)((const char *) src1->data + in*ofs0 + iic*ofs1)
+                        : nullptr; // [IH, IW]
+                    const ggml_fp16_t * const src_data_f16 = src1->type == GGML_TYPE_F16
+                        ? (const ggml_fp16_t *)((const char *) src1->data + in*ofs0 + iic*ofs1)
+                        : nullptr; // [IH, IW]
+
+                    for (int64_t ikh = 0; ikh < KH; ikh++) {  // 1
+                        for (int64_t ikw = 0; ikw < KW; ikw++) {
+                            const int64_t iiw = iow*s0 + ikw*d0 - p0;
+                            const int64_t iih = ioh*s1 + ikh*d1 - p1;
+
+                            if (iih < 0 || iih >= IH || iiw < 0 || iiw >= IW) {
+                                dst_data[iic*(KH*KW) + ikh*KW + ikw] = 0;
+                            } else {
+                                if (src_data_f32 != nullptr) {
+                                    dst_data[iic*(KH*KW) + ikh*KW + ikw] = GGML_CPU_FP32_TO_FP16(src_data_f32[iih*IW + iiw]);
                                 } else {
-                                    if (src_data_f32 != nullptr) {
-                                        dst_data[iic*(KH*KW) + ikh*KW + ikw] = GGML_CPU_FP32_TO_FP16(src_data_f32[iih*IW + iiw]);
-                                    } else {
-                                        dst_data[iic*(KH*KW) + ikh*KW + ikw] = src_data_f16[iih*IW + iiw];
-                                    }
+                                    dst_data[iic*(KH*KW) + ikh*KW + ikw] = src_data_f16[iih*IW + iiw];
                                 }
                             }
                         }
