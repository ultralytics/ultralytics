+#ifdef GGML_CUDA_USE_CUTLASS
+static __global__ void bias_silu_nhwc_kernel(
+        half * output, const float * bias, int64_t channels, int64_t total) {
+    const int64_t index = blockIdx.x * blockDim.x + threadIdx.x;
+    if (index >= total) return;
+    const float value = __half2float(output[index]) + bias[index % channels];
+    output[index] = __float2half(value / (1.0f + expf(-value)));
+}
