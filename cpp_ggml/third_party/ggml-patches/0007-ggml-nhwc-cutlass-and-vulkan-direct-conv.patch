+static bool run_cutlass_plan(ggml_tensor * dst, cudnn_conv_plan & plan, cudaStream_t stream) {
+    const ggml_tensor * input = dst->src[1];
+    nchw_to_nhwc(input->data, plan.frontend_input, CUDNN_DATA_HALF,
+                 input->ne[3], input->ne[2], input->ne[1], input->ne[0], stream);
+    if (!ggml_cuda_cutlass_conv_run(plan.cutlass_plan, stream)) return false;
+    if (dst->src[2] && ggml_get_op_params_i32(dst, 7) == 1) {
+        const int64_t total = ggml_nelements(dst);
+        const int blocks = (total + CUDA_CONV2D_BLOCK_SIZE - 1) / CUDA_CONV2D_BLOCK_SIZE;
+        bias_silu_nhwc_kernel<<<blocks, CUDA_CONV2D_BLOCK_SIZE, 0, stream>>>(
+            (half *) plan.frontend_output, (const float *) dst->src[2]->data, dst->ne[2], total);
+    }
+    nhwc_to_nchw(plan.frontend_output, dst->data, CUDNN_DATA_HALF,
+                 dst->ne[3], dst->ne[2], dst->ne[1], dst->ne[0], stream);
+    return cudaPeekAtLastError() == cudaSuccess;
+}
+
+static float time_cutlass_plan(ggml_tensor * dst, cudnn_conv_plan & plan, cudaStream_t stream) {
+    if (!run_cutlass_plan(dst, plan, stream) || cudaStreamSynchronize(stream) != cudaSuccess) {
+        cudaGetLastError();
+        return std::numeric_limits<float>::max();
+    }
+    cudaEvent_t start = nullptr;
+    cudaEvent_t stop = nullptr;
+    cudaEventCreate(&start);
+    cudaEventCreate(&stop);
+    std::array<float, 3> times{};
+    for (float & time : times) {
+        cudaEventRecord(start, stream);
+        if (!run_cutlass_plan(dst, plan, stream)) {
+            time = std::numeric_limits<float>::max();
+            break;
+        }
+        cudaEventRecord(stop, stream);
+        cudaEventSynchronize(stop);
+        cudaEventElapsedTime(&time, start, stop);
+    }
+    cudaEventDestroy(stop);
+    cudaEventDestroy(start);
+    std::sort(times.begin(), times.end());
+    return times[1];
+}
